---
/**
 * A screenshot of the application in a browser window. Both colour schemes
 * are rendered; the stylesheet shows the one matching the active theme.
 */
import type { ImageMetadata } from 'astro';

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  url: string;
  class?: string;
}

const { light, dark, alt, url, class: className } = Astro.props;
---

<div class:list={['k-mock', className]}>
  <div class="k-bar">
    <span class="k-dot"></span><span class="k-dot"></span><span class="k-dot"></span>
    <span class="k-url">{url}</span>
  </div>
  <div class="k-shot">
    <img class="k-img-light" src={light.src} width={light.width} height={light.height} alt={alt} loading="lazy" decoding="async" />
    <img class="k-img-dark" src={dark.src} width={dark.width} height={dark.height} alt="" loading="lazy" decoding="async" />
  </div>
</div>
