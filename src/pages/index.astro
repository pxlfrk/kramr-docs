---
import { BaseLayout, SiteFooter, SiteHeader } from '@prosefly/astro-theme-lotus/layouts';
import { Icon } from '@prosefly/astro-components';
import Shot from '../components/Shot.astro';
import { home } from '../data/home.de';
import '../styles/landing.css';
import anfrageDark from '../assets/screenshots/anfrage-dunkel.webp';
import anfrageLight from '../assets/screenshots/anfrage-hell.webp';
import bestandDark from '../assets/screenshots/bestand-dunkel.webp';
import bestandLight from '../assets/screenshots/bestand-hell.webp';
import kalenderDark from '../assets/screenshots/kalender-dunkel.webp';
import kalenderLight from '../assets/screenshots/kalender-hell.webp';
import rueckgabeDark from '../assets/screenshots/rueckgabe-dunkel.webp';
import rueckgabeLight from '../assets/screenshots/rueckgabe-hell.webp';

// The base path is added to every site link after the build (plugins/base-path.mjs).
const [anfragen, einbettung, bestand, uebersicht] = home.features;
const embedIcons = ['lucide:tent', 'lucide:projector', 'lucide:package'];
---

<BaseLayout title={home.title} description={home.hero.description}>
  <SiteHeader surface />

  <main class="k-page">
    <!-- Hero -->
    <section class="k-wrap k-hero">
      <div class="k-eyebrow">{home.hero.eyebrow}</div>
      <h1 class="k-h1">
        {home.hero.lead}
        <span class="k-word">
          <span class="sr-only">{home.hero.words[0]}?</span>
          <span class="k-word-track" data-words aria-hidden="true">
            {[...home.hero.words, home.hero.words[0]].map((word) => <span class="k-word-item">{word}?</span>)}
          </span>
        </span>
      </h1>
      <div class="k-hero-row">
        <p class="k-hero-lead">{home.hero.description}</p>
        <div class="k-actions">
          {
            home.hero.actions.map((action) => (
              <a class:list={['k-btn', action.primary ? 'k-btn--solid' : 'k-btn--line']} href={action.href}>
                {action.label}
                <Icon name="lucide:arrow-right" class="size-4" />
              </a>
            ))
          }
        </div>
      </div>

      <div class="k-tags">
        <div class="k-tags-grid">
          {
            home.hero.tags.map((tag) => (
              <div class="k-tag" style={`--k-tilt:${tag.tilt}deg`}>
                <span class="k-hole" />
                <div class="k-mono k-small">{tag.number}</div>
                <div class="k-tag-name">{tag.name}</div>
                <span class="k-pill" data-tone={tag.tone}>{tag.status}</span>
                <div class="k-mono k-tag-when">{tag.when}</div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="k-wrap">
      <ul class="k-facts">
        {home.facts.map((fact) => <li>{fact}</li>)}
      </ul>
    </section>

    <!-- 01 Request by link -->
    <section id={anfragen.id} class="k-sec">
      <div class="k-wrap k-split">
        <div class="k-split-text">
          <div class="k-eyebrow">{anfragen.eyebrow}</div>
          <h2 class="k-h2">{anfragen.title}</h2>
          <p class="k-lead">{anfragen.description}</p>
          <ul class="k-points">
            {anfragen.points.map((point) => <li><Icon name="lucide:check" class="size-5" /><span>{point}</span></li>)}
          </ul>
          <a class="k-more" href={anfragen.more.href}><Icon name="lucide:book-open" class="size-4" aria-hidden="true" />{anfragen.more.label}</a>
        </div>
        <div class="k-split-visual k-request-wrap">
          <Shot
            light={anfrageLight}
            dark={anfrageDark}
            url="verleih.beispiel-verein.de / anfrage"
            alt="Die Anfrage-Seite: wer, wann und was, mit der Schaltfläche Einreichen."
          />
          <div class="k-mock k-mail">
            <div class="k-bar"><span class="k-url">{home.email.from}</span></div>
            <div class="k-mail-body">
              <div><b>{home.email.subject}</b></div>
              <p>{home.email.body}</p>
              <span class="k-btn k-btn--solid">{home.email.button}</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 02 Embedding -->
    <section id={einbettung.id} class="k-sec">
      <div class="k-wrap k-split k-split--reverse">
        <div class="k-split-text">
          <div class="k-eyebrow">{einbettung.eyebrow}</div>
          <h2 class="k-h2">{einbettung.title}</h2>
          <p class="k-lead">{einbettung.description}</p>
          {
            einbettung.focus && (
              <div class="k-focus">
                <Icon name="lucide:list-filter" class="size-6" aria-hidden="true" />
                <div>
                  <b>{einbettung.focus.title}</b>
                  <p>{einbettung.focus.description}</p>
                </div>
              </div>
            )
          }
          <ul class="k-points">
            {einbettung.points.map((point) => <li><Icon name="lucide:check" class="size-5" /><span>{point}</span></li>)}
          </ul>
          <a class="k-more" href={einbettung.more.href}><Icon name="lucide:book-open" class="size-4" aria-hidden="true" />{einbettung.more.label}</a>
        </div>
        <div class="k-split-visual">
          <div class="k-mock">
            <div class="k-bar">
              <span class="k-dot"></span><span class="k-dot"></span><span class="k-dot"></span>
              <span class="k-url">{home.embed.url}</span>
            </div>
            <div class="k-site-head">
              <div class="k-disp" style="font-size:1.5rem;font-weight:800">{home.embed.site}</div>
              <div class="k-small">{home.embed.tagline}</div>
            </div>
            <div class="k-embed">
              <span class="k-embed-badge">{home.embed.badge}</span>
              <div class="k-embed-filter">
                <span class="k-field">{home.embed.filter.search}</span>
                <span class="k-field k-field--ring">{home.embed.filter.category} ▾</span>
                <span class="k-field">{home.embed.filter.period}</span>
              </div>
              <div class="k-embed-grid">
                {
                  home.embed.items.map((item, index) => (
                    <div class="k-card k-embed-card">
                      <div class="k-embed-art" data-tone={item.tone}>
                        <Icon name={embedIcons[index] ?? 'lucide:package'} class="size-10" />
                      </div>
                      <div class="k-embed-info">
                        <b>{item.name}</b>
                        <div class="k-mono k-small" style="margin-bottom:0.5rem">{item.meta}</div>
                        <span class="k-pill" data-tone="draft">{item.note}</span>
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 03 Stock -->
    <section id={bestand.id} class="k-sec">
      <div class="k-wrap k-split">
        <div class="k-split-text">
          <div class="k-eyebrow">{bestand.eyebrow}</div>
          <h2 class="k-h2">{bestand.title}</h2>
          <p class="k-lead">{bestand.description}</p>
          <ul class="k-points">
            {bestand.points.map((point) => <li><Icon name="lucide:check" class="size-5" /><span>{point}</span></li>)}
          </ul>
          <a class="k-more" href={bestand.more.href}><Icon name="lucide:book-open" class="size-4" aria-hidden="true" />{bestand.more.label}</a>
        </div>
        <div class="k-split-visual">
          <Shot
            light={bestandLight}
            dark={bestandDark}
            url="kramr / Bestand"
            alt="Die Bestandsliste mit Kategorien, Standorten, Beständen und Preisen."
          />
        </div>
      </div>
    </section>

    <!-- 04 Overview -->
    <section id={uebersicht.id} class="k-sec">
      <div class="k-wrap k-split k-split--reverse">
        <div class="k-split-text">
          <div class="k-eyebrow">{uebersicht.eyebrow}</div>
          <h2 class="k-h2">{uebersicht.title}</h2>
          <p class="k-lead">{uebersicht.description}</p>
          <ul class="k-points">
            {uebersicht.points.map((point) => <li><Icon name="lucide:check" class="size-5" /><span>{point}</span></li>)}
          </ul>
          <a class="k-more" href={uebersicht.more.href}><Icon name="lucide:book-open" class="size-4" aria-hidden="true" />{uebersicht.more.label}</a>
        </div>
        <div class="k-split-visual">
          <Shot
            light={kalenderLight}
            dark={kalenderDark}
            url="kramr / Buchungen / Kalender"
            alt="Der Buchungskalender, Monatsansicht, mit Buchungen in verschiedenen Status."
          />
          <div class="k-sticker k-sticker--warn">Konflikt = Hinweis, keine Sperre</div>
        </div>
      </div>
    </section>

    <!-- 05 Flow -->
    <section id={home.flow.id} class="k-sec">
      <div class="k-wrap">
        <div class="k-eyebrow">{home.flow.eyebrow}</div>
        <h2 class="k-h2" style="max-width:48rem">{home.flow.title}</h2>
        <p class="k-lead" style="max-width:40rem">{home.flow.description}</p>
        <div class="k-steps">
          {
            home.flow.steps.map((step) => (
              <div class="k-step">
                <span class="k-hole" />
                <div class="k-label">{step.label}</div>
                <div class="k-step-title">{step.title}</div>
                <p>{step.description}</p>
              </div>
            ))
          }
        </div>
        <div class="k-split k-return">
          <div class="k-return-shot">
            <Shot
              light={rueckgabeLight}
              dark={rueckgabeDark}
              url="kramr / Rückgabe"
              alt="Die Rückgabe: Zustand je Position mit In Ordnung, Beschädigt und Verloren."
            />
          </div>
          <div class="k-split-text">
            <div class="k-eyebrow">{home.flow.returns.eyebrow}</div>
            <h3 class="k-h3">{home.flow.returns.title}</h3>
            <p class="k-lead">{home.flow.returns.description}</p>
            <div class="k-pills">
              {home.flow.returns.states.map((state) => <span class="k-pill" data-tone={state.tone}>{state.label}</span>)}
            </div>
            <a class="k-more" href={home.flow.returns.more.href}><Icon name="lucide:book-open" class="size-4" aria-hidden="true" />{home.flow.returns.more.label}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- History and privacy -->
    <section id={home.history.id} class="k-sec">
      <div class="k-wrap k-split">
        <div class="k-split-text">
          <div class="k-eyebrow">{home.history.eyebrow}</div>
          <h2 class="k-h2">{home.history.title}</h2>
          <p class="k-lead">{home.history.description}</p>
          <ul class="k-points">
            {home.history.points.map((point) => <li><Icon name="lucide:check" class="size-5" /><span>{point}</span></li>)}
          </ul>
          <div class="k-links">
            <a class="k-more" href={home.history.more.href}><Icon name="lucide:book-open" class="size-4" aria-hidden="true" />{home.history.more.label}</a>
            <a class="k-more" href={home.history.moreAdmin.href}><Icon name="lucide:book-open" class="size-4" aria-hidden="true" />{home.history.moreAdmin.label}</a>
          </div>
        </div>
        <div class="k-split-visual">
          <div class="k-mock">
            <div class="k-bar">
              <span class="k-dot"></span><span class="k-dot"></span><span class="k-dot"></span>
              <span class="k-url">{home.history.item.url}</span>
            </div>
            <div class="k-history-head">
              <span class="k-disp" style="font-size:1.5rem;font-weight:800">{home.history.item.name}</span>
              <span class="k-mono k-small">{home.history.item.meta}</span>
            </div>
            <ol class="k-history">
              {
                home.history.entries.map((entry, index) => (
                  <li class="k-entry">
                    <div class="k-mono k-entry-date">{entry.date}</div>
                    <div class="k-entry-rail">
                      <span class="k-entry-dot" data-tone={entry.tone} />
                      {index < home.history.entries.length - 1 && <span class="k-entry-line" />}
                    </div>
                    <div class="k-entry-body">
                      <div class="k-entry-title">
                        <span>{entry.title}</span>
                        <a href="#datenschutz">{entry.booking}</a>
                      </div>
                      <div class="k-entry-note">
                        {entry.state && <span class="k-pill" data-tone={entry.tone}>{entry.state}</span>}
                        <span>{entry.note}</span>
                      </div>
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </div>
    </section>

    <!-- Extras -->
    <section class="k-sec">
      <div class="k-wrap">
        <div class="k-eyebrow">Außerdem</div>
        <h2 class="k-h2">{home.extras.title}</h2>
        <div class="k-grid">
          {
            home.extras.items.map((item) => (
              <div class="k-card k-grid-card">
                <Icon name={item.icon} class="size-7" />
                <div class="k-grid-title">{item.title}</div>
                <p>{item.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- What kramr is not -->
    <section class="k-sec">
      <div class="k-wrap">
        <div class="k-nots">
          <div style="flex:1 1 20rem">
            <div class="k-eyebrow">{home.nots.eyebrow}</div>
            <h2>{home.nots.title}</h2>
          </div>
          <ul>
            {home.nots.items.map((item) => <li><span>×</span><span><b>{item.head}</b> {item.text}</span></li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- Documentation -->
    <section id={home.docs.id} class="k-sec">
      <div class="k-wrap">
        <div class="k-eyebrow">{home.docs.eyebrow}</div>
        <h2 class="k-h2">{home.docs.title}</h2>
        <div class="k-grid">
          {
            home.docs.items.map((doc) => (
              <a class="k-card k-grid-card k-grid-card--docs" href={doc.href}>
                <Icon name={doc.icon} class="size-7" />
                <div class="k-mono k-small" style="margin-top:0.75rem">{doc.kicker}</div>
                <div class="k-grid-title" style="margin-top:0.2rem">{doc.title}</div>
                <p>{doc.description}</p>
                <span class="k-cta-link">{doc.label} →</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Closing call to action -->
    <section class="k-wrap k-end">
      <div class="k-cta">
        <div style="flex:1 1 22rem">
          <h2>{home.cta.title}</h2>
          <p>{home.cta.description}</p>
        </div>
        <div class="k-actions">
          {
            home.cta.actions.map((action, index) =>
              action.href ? (
                <a class:list={['k-btn', index === 0 ? 'k-btn--ink' : 'k-btn--line']} href={action.href}>
                  {action.label}
                </a>
              ) : (
                <span class="k-btn k-btn--line k-btn--disabled" aria-disabled="true">
                  {action.label}
                  {action.note && <span class="k-mono k-small">{action.note}</span>}
                </span>
              ),
            )
          }
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<script>
  // Swaps the object in the headline every couple of seconds. Without
  // JavaScript, or when the reader prefers reduced motion, the first one stays.
  const track = document.querySelector<HTMLElement>('[data-words]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (track && !reduce) {
    // The first word is repeated at the end, so the loop closes with a swap
    // in the same direction; then the track jumps back without animation.
    const count = track.children.length - 1;
    let index = 0;
    window.setInterval(() => {
      index += 1;
      track.style.setProperty('--k-word', String(index));
    }, 2200);
    track.addEventListener('transitionend', () => {
      if (index < count) return;
      index = 0;
      track.style.transition = 'none';
      track.style.setProperty('--k-word', '0');
      void track.offsetHeight;
      track.style.transition = '';
    });
  }
</script>
