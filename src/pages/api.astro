---
import { BaseLayout, SiteFooter, SiteHeader } from '@prosefly/astro-theme-lotus/layouts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="API-Referenz"
  description="Die öffentlichen Schnittstellen von kramr, erzeugt aus dem API-Vertrag."
>
  <SiteHeader surface currentPath="/api/" />

  <main>
    <div id="api-reference" data-spec={`${base}/openapi/api.yaml`}>
      <noscript>
        <p class="p-6">
          Die API-Referenz braucht JavaScript. Der Vertrag steht auch als
          <a href={`${base}/openapi/api.yaml`}>OpenAPI-Datei</a> bereit.
        </p>
      </noscript>
    </div>
  </main>

  <SiteFooter />

  <script is:inline src={`${base}/vendor/scalar.js`}></script>
  <script is:inline>
    (function () {
      var root = document.getElementById('api-reference');
      var theme = document.documentElement.dataset.theme;
      var dark =
        theme === 'dark' ||
        ((theme === 'system' || !theme) && matchMedia('(prefers-color-scheme: dark)').matches);
      window.Scalar.createApiReference(root, {
        url: root.dataset.spec,
        forceDarkModeState: dark ? 'dark' : 'light',
        hideDarkModeToggle: true,
        hideClientButton: true,
        hideTestRequestButton: true,
        withDefaultFonts: false,
        // The site's own fonts (public/fonts), no font service.
        customCss:
          'html .scalar-app { --scalar-font: "Hanken Grotesk Variable", system-ui, sans-serif; --scalar-font-code: "DM Mono", ui-monospace, monospace; }',
        showDeveloperTools: 'never',
        defaultOpenFirstTag: true,
        agent: { disabled: true },
      });
    })();
  </script>
</BaseLayout>
