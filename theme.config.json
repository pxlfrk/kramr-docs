{
  "$schema": "https://prosefly.dev/schema/lotus.json",
  "name": "kramr",
  "description": "Materialverwaltung für Jugendverbände und Vereine: Ausleihe, Bestand und Verfügbarkeit an einem Ort.",
  "favicon": "/favicon.svg",
  "logo": "/logo.svg",
  "docsBase": "/docs",
  "defaultLocale": "root",
  "locales": {
    "root": {
      "label": "Deutsch",
      "lang": "de"
    }
  },
  "siteNav": [
    {
      "label": "Anwender-Handbuch",
      "href": "/docs/user/getting-started/"
    },
    {
      "label": "Betreiber-Guide",
      "href": "/docs/admin/installation/"
    },
    {
      "label": "API-Referenz",
      "href": "/api/"
    }
  ],
  "socials": [],
  "search": {
    "provider": "local"
  },
  "docsNav": [
    {
      "label": "Anwender-Handbuch",
      "icon": "lucide:users",
      "items": [
        {
          "autogenerate": {
            "directory": "user"
          }
        }
      ]
    },
    {
      "label": "Betreiber-Guide",
      "icon": "lucide:server",
      "items": [
        {
          "autogenerate": {
            "directory": "admin"
          }
        }
      ]
    },
    {
      "label": "Für Entwickler",
      "icon": "lucide:code-xml",
      "items": [
        {
          "autogenerate": {
            "directory": "developer"
          }
        }
      ]
    }
  ],
  "footer": {
    "copyright": "Materialverleih für Jugendverbände und Vereine."
  },
  "pageActions": [
    {
      "type": "copy-page",
      "icon": "lucide:copy"
    },
    {
      "type": "view-markdown",
      "icon": "lucide:file-text"
    }
  ],
  "iconify": {
    "preload": ["lucide:chevrons-up-down"]
  },
  "credits": false,
  "head": [
    {
      "tag": "link",
      "attrs": {
        "rel": "preload",
        "as": "font",
        "type": "font/woff2",
        "href": "/fonts/hanken-grotesk-latin-wght-normal.woff2",
        "crossorigin": "anonymous"
      }
    },
    {
      "tag": "link",
      "attrs": {
        "rel": "preload",
        "as": "font",
        "type": "font/woff2",
        "href": "/fonts/bricolage-grotesque-latin-wght-normal.woff2",
        "crossorigin": "anonymous"
      }
    },
    {
      "tag": "style",
      "src": "src/styles/kramr.css"
    }
  ],
  "markdown": {
    "packageManagerTabs": false
  }
}
