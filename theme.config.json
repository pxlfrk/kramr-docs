{
  "$schema": "https://prosefly.dev/schema/lotus.json",
  "name": "kramr",
  "description": "Materialverwaltung für Jugendverbände und Vereine: Ausleihe, Bestand und Verfügbarkeit an einem Ort.",
  "favicon": "/favicon.svg",
  "logo": "/logo.svg",
  "docsBase": "/docs",
  "defaultLocale": "root",
  "locales": {
    "root": {
      "label": "Deutsch",
      "lang": "de"
    }
  },
  "siteNav": [
    {
      "label": "Anwender",
      "href": "/docs/user/getting-started/"
    },
    {
      "label": "Betreiber",
      "href": "/docs/admin/installation/"
    },
    {
      "label": "API",
      "href": "/api/"
    }
  ],
  "socials": [
    {
      "label": "GitHub",
      "href": "https://github.com/pxlfrk/kramr",
      "external": true,
      "icon": "github"
    }
  ],
  "search": {
    "provider": "local"
  },
  "docsNav": [
    {
      "label": "Für Anwender",
      "icon": "lucide:users",
      "items": [
        {
          "autogenerate": {
            "directory": "user"
          }
        }
      ]
    },
    {
      "label": "Für Betreiber",
      "icon": "lucide:server",
      "items": [
        {
          "autogenerate": {
            "directory": "admin"
          }
        }
      ]
    },
    {
      "label": "Für Entwickler",
      "icon": "lucide:code-xml",
      "items": [
        {
          "autogenerate": {
            "directory": "developer"
          }
        }
      ]
    }
  ],
  "footer": {
    "copyright": "kramr ist freie Software (MIT-Lizenz).",
    "sections": [
      {
        "title": "Dokumentation",
        "links": [
          {
            "label": "Anwender",
            "href": "/docs/user/getting-started/"
          },
          {
            "label": "Betreiber",
            "href": "/docs/admin/installation/"
          },
          {
            "label": "API-Referenz",
            "href": "/api/"
          }
        ]
      },
      {
        "title": "Projekt",
        "links": [
          {
            "label": "GitHub",
            "href": "https://github.com/pxlfrk/kramr",
            "external": true
          }
        ]
      }
    ]
  },
  "pageActions": [
    {
      "type": "copy-page",
      "icon": "lucide:copy"
    },
    {
      "type": "view-markdown",
      "icon": "lucide:file-text"
    }
  ],
  "iconify": {
    "preload": ["lucide:chevrons-up-down"]
  }
}
