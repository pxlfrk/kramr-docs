# Production template for `compose.yaml`.
#
# Copy this file to `.env` next to `compose.yaml` on the server — NOT
# `.env.example`, which is the development template and carries dev-only
# values (`KRAMR_SERVER_TRUST_PROXY=false`, a fixed bootstrap subject,
# placeholder secrets) that are unsafe behind a shared reverse proxy. This
# file is kept in `ops/` because `.gitignore` excludes every `.env.*` file
# except `.env.example`.
#
# Required values below are left empty; the stack refuses to start until they
# are filled in. See the operator documentation
# (https://pxlfrk.github.io/kramr-docs/, "Installation") for the full,
# step-by-step walkthrough this template is part of.

# --- Database (compose.yaml builds KRAMR_DB_URL from these) -----------------
# No defaults on purpose — the stack refuses to start rather than run with a
# built-in password. Set a real password before the first start: the database
# keeps the one it was created with.
KRAMR_DB_NAME=kramr
KRAMR_DB_USER=kramr
KRAMR_DB_PASSWORD=

# --- Server -------------------------------------------------------------
# External URL the application is reached under, behind the reverse proxy.
# Also the base of the OIDC callback URL (<KRAMR_SERVER_PUBLIC_URL>/api/auth/callback).
KRAMR_SERVER_PUBLIC_URL=

# Trust X-Forwarded-* headers. Safe default for this template: a production
# deployment sits behind a reverse proxy (operator documentation, "Reverse Proxy"). Set to false
# only if the container is exposed directly, without a proxy in front.
KRAMR_SERVER_TRUST_PROXY=true

# Redirect plain HTTP to KRAMR_SERVER_PUBLIC_URL. Left off: this is the
# reverse proxy's job, not the application's, in every deployment this
# template targets.
KRAMR_SERVER_FORCE_HTTPS=false

# --- OpenID Connect (FR-40) -------------------------------------------------
# Required: signing in is the only way into the application. Register a
# client with your provider first (operator documentation, "Reverse Proxy").
KRAMR_OIDC_ISSUER_URL=
KRAMR_OIDC_CLIENT_ID=
KRAMR_OIDC_CLIENT_SECRET=

# Optional: where roles come from (FR-84, ADR 0027). Leave unset for the
# built-in user administration (`local`). See the operator documentation, "Anmeldung und Rollen",, before switching to `groups`.
# KRAMR_OIDC_ROLES_SOURCE=groups
# KRAMR_OIDC_ROLES_GROUPS_CLAIM=groups
# KRAMR_OIDC_ROLES_GROUP_ADMIN=kramr_admin
# KRAMR_OIDC_ROLES_GROUP_STAFF=kramr_staff
# KRAMR_OIDC_ROLES_GROUP_READ_ONLY=kramr_read

# Optional: the OIDC subject (`sub`) of the first administrator (NFR-14).
# Commissioning only — set it, sign that person in once, then remove it and
# restart (operator documentation, "Erster Administrator"). No safe default: leaving
# this template's placeholder blank is the point, unlike the development
# template's fixed `kramr-dev`.
KRAMR_AUTH_BOOTSTRAP_ADMIN_SUBJECT=

# Optional: 32 random bytes, Base64 (`openssl rand -base64 32`). Lets staff copy
# an issued request link again from the contact; without it a link is shown
# once. Changing it makes already stored links uncopyable.
# KRAMR_REQUEST_LINK_KEY=

# --- Compose stack -----------------------------------------------------
# Host port the application is published on, bound to loopback for the proxy.
# Only relevant with a reverse proxy on the host; a proxy container on the same
# Docker network reaches the app as `app:3000` (operator documentation, "Reverse Proxy").
KRAMR_PUBLISH_PORT=3000

# Image tag to run. Required — compose.yaml refuses to start without it,
# because production runs tagged versions only, never "latest" (NFR-10).
# Replace with a real release: https://github.com/pxlfrk/kramr/releases
KRAMR_IMAGE_TAG=

# --- Everything else --------------------------------------------------------
# Optional variables not listed here (log level, SMTP, webhook allowlist,
# reminder/inactivity defaults, the GitHub repository for the update check)
# take their documented defaults. See the full list in docs/public/admin/configuration/umgebungsvariablen.md
# and .env.example for what each one does.
