{
  "name": "kramr-docs-site",
  "version": "0.0.0",
  "private": true,
  "description": "Public documentation and product site of kramr. Generated from the kramr repository; do not edit by hand.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "stage": "node scripts/stage-content.mjs",
    "dev": "npm run stage && KRAMR_DOCS_BASE=/ astro dev",
    "build": "npm run stage && astro build && node scripts/check-build.mjs",
    "preview": "astro preview",
    "test": "node --test test/",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/mdx": "8.1.3",
    "@astrojs/sitemap": "3.7.4",
    "@prosefly/astro-components": "0.8.4",
    "@prosefly/astro-theme-lotus": "0.9.1",
    "@scalar/api-reference": "1.77.0",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.7",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@ai-sdk/provider-utils": "5.0.76",
    "postcss-selector-parser": "7.2.0"
  }
}
